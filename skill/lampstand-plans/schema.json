{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lampstand.app/schema/plan-v2.json",
  "title": "Lampstand reading plan",
  "description": "A Lampstand reading plan (.lampstand-plan.json): daily Bible readings or weekly lessons. Readings are references only, never scripture text.",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "lampstand-plan"
    },
    "version": {
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        }
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,59}$",
      "description": "Stable id, e.g. \"parables-8-weeks\". Re-importing the same id updates it."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "pace": {
      "type": "string",
      "enum": ["daily", "weekly", "monthly"],
      "description": "\"daily\": one day at a time. \"weekly\": a new lesson each Sunday. \"monthly\": a new lesson each month."
    },
    "categories": {
      "description": "Version 2. Where the plan appears in Discover; several are allowed.",
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "string",
        "description": "A category or subcategory id from catalog.json.",
        "enum": [
          "anxiety",
          "worry",
          "fear",
          "stress",
          "anger",
          "loss",
          "loneliness",
          "healing",
          "letting-go",
          "forgiveness",
          "hope",
          "peace",
          "joy",
          "love",
          "gratitude",
          "money",
          "temptation",
          "pride",
          "doubt",
          "through-the-bible",
          "four-gospels",
          "life-of-jesus",
          "parables",
          "miracles",
          "psalms-of-david",
          "wisdom",
          "new-to-faith",
          "first-steps",
          "who-is-jesus",
          "learning-to-pray",
          "reading-the-bible",
          "belonging",
          "discipleship",
          "spiritual-habits",
          "character",
          "sharing-faith",
          "ministry",
          "serving",
          "leading",
          "teaching",
          "worship",
          "relationships",
          "marriage",
          "parenting",
          "friendship",
          "sunday-school",
          "small-groups",
          "youth",
          "children"
        ]
      }
    },
    "audience": {
      "description": "Version 2. \"personal\" reading, or lessons for a \"group\" or class.",
      "type": "string",
      "enum": ["personal", "group"]
    },
    "level": {
      "description": "Version 2. Optional, e.g. \"New to faith\".",
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "cover": {
      "description": "Version 2. A bundled background id used as the plan’s cover.",
      "type": "string",
      "pattern": "^[a-z0-9-]{1,60}$"
    },
    "days": {
      "minItems": 1,
      "maxItems": 400,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "description": "Optional, e.g. \"The Prodigal Son\".",
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "readings": {
            "minItems": 1,
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "description": "A Bible reference, e.g. \"Luke 15:11-32\", \"Psalm 23\", \"Genesis 1-3\"."
            }
          },
          "note": {
            "description": "A short teaching note shown before the readings. Plain text.",
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "questions": {
            "description": "Discussion or reflection questions shown after the readings.",
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          },
          "devotional": {
            "description": "Version 2. A short devotional (plain text, your own words) read after the readings.",
            "type": "string",
            "minLength": 1,
            "maxLength": 3000
          },
          "prayer": {
            "description": "Version 2. A short prayer to close the day, in your own words.",
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": ["readings"],
        "additionalProperties": false
      }
    }
  },
  "required": ["format", "version", "id", "name", "description", "pace", "days"],
  "additionalProperties": false
}
